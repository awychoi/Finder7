# ---------------------------------------------------------------------------
# Content rules
# ---------------------------------------------------------------------------

SECRET_RULES = [
    ("AWS access key", re.compile(r"\b(?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\b")),
    ("GitHub token", re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,255}\b")),
    ("GitHub fine-grained token", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{60,}\b")),
    ("GitLab token", re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}\b")),
    ("Slack token", re.compile(r"\bxox[abprs]-[0-9A-Za-z-]{10,}\b")),
    ("Slack webhook", re.compile(r"https://hooks\.slack\.com/services/[A-Za-z0-9/]+")),
    ("Stripe key", re.compile(r"\b[rs]k_(?:live|test)_[0-9A-Za-z]{16,}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("Anthropic key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}\b")),
    ("OpenAI key", re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}\b")),
    ("Hugging Face token", re.compile(r"\bhf_[A-Za-z0-9]{30,}\b")),
    ("npm token", re.compile(r"\bnpm_[A-Za-z0-9]{36}\b")),
    ("PyPI token", re.compile(r"\bpypi-[A-Za-z0-9_-]{40,}\b")),
    ("SendGrid key", re.compile(r"\bSG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\b")),
    ("DigitalOcean token", re.compile(r"\bdop_v1_[a-f0-9]{64}\b")),
    ("Telegram bot token", re.compile(r"\b\d{8,10}:AA[A-Za-z0-9_-]{30,}\b")),
    (
        "Discord webhook",
        re.compile(
            r"https://(?:canary\.|ptb\.)?discord(?:app)?\.com/api/webhooks/"
            r"\d+/[A-Za-z0-9_-]+"
        ),
    ),
    ("Azure account key", re.compile(r"(?i)\bAccountKey=[A-Za-z0-9+/=]{40,}")),
    ("Vault token", re.compile(r"\bhvs\.[A-Za-z0-9_-]{20,}\b")),
    (
        "Private key block",
        re.compile(
            r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----"
        ),
    ),
    (
        "JWT",
        re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"),
    ),
    ("Bearer token", re.compile(r"(?i)\bbearer\s+[A-Za-z0-9\-._~+/]{24,}")),
    ("Credentials in URL", re.compile(r"https?://[^/\s:@]+:[^/\s@]{3,}@[^/\s]+")),
    (
        "Hardcoded secret assignment",
        re.compile(
            r"(?i)\b(api[_-]?key|secret[_-]?key|client[_-]?secret|access[_-]?token|"
            r"auth[_-]?token|private[_-]?key|secret|token)\b\s*[:=]\s*['\"]?"
            r"([A-Za-z0-9_\-+/=]{16,})['\"]?"
        ),
    ),
    (
        "Hardcoded password",
        re.compile(r"(?i)\b(?:password|passwd|pwd)\b\s*[:=]\s*['\"]([^'\"\s]{12,})['\"]"),
    ),
]

PII_RULES = [
    ("Home directory path", re.compile(r"(?<![\w.-])/(?:Users|home)/([A-Za-z0-9._-]+)")),
    ("Email address", re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b")),
    (
        "US phone number",
        re.compile(r"(?<![\d.])(?:\+1[-. ]?)?\(?\d{3}\)?[-. ]\d{3}[-. ]\d{4}(?![\d.])"),
    ),
    ("SSN", re.compile(r"(?<![\d-])\d{3}-\d{2}-\d{4}(?![\d-])")),
    ("Payment card number", re.compile(r"(?<![\d-])(?:\d[ -]?){13,19}(?![\d-])")),
    ("MAC address", re.compile(r"\b[0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}\b")),
]

WARN_RULES = [
    (
        "Private network address",
        re.compile(
            r"(?<![\d.])(?:10\.\d{1,3}|192\.168|172\.(?:1[6-9]|2\d|3[01]))"
            r"\.\d{1,3}\.\d{1,3}(?![\d.])"
        ),
    ),
]

SAFE_EMAIL_DOMAINS = {
    "users.noreply.github.com",
    "noreply.github.com",
    "example.com",
    "example.org",
    "example.net",
    "test.com",
    "localhost",
    "invalid",
    "7-zip.org",
    "gnu.org",
    "w3.org",
}
SAFE_EMAIL_LOCALS = {
    "git", "noreply", "no-reply", "user", "username", "name", "email",
    "author", "you", "your", "test",
}
SAFE_USER_DIRS = {
    "Shared", "runner", "you", "me", "user", "username", "example", "test",
}
EXAMPLE_EMBEDDED_EXTS = {
    "png", "jpg", "jpeg", "gif", "svg", "pdf", "zip", "gz", "tar", "txt",
    "md", "json", "yaml", "yml", "swift", "sh", "plist", "xml", "html",
    "css", "js", "ts", "icns", "webp", "heic", "tiff",
}
PLACEHOLDER = re.compile(
    r"(?i)(example|placeholder|dummy|fake|sample|changeme|your[_-]?(?:key|token|secret)"
    r"|<[^>]+>|\$\{|\$\(|\.\.\.|xxx+)"
)
SAFE_MACS = {
    "00:00:00:00:00:00", "ff:ff:ff:ff:ff:ff", "aa:bb:cc:dd:ee:ff",
    "11:22:33:44:55:66",
}


def entropy(value: str) -> float:
    if not value:
        return 0.0
    counts = {}
    for ch in value:
        counts[ch] = counts.get(ch, 0) + 1
    return -sum((n / len(value)) * math.log2(n / len(value)) for n in counts.values())


def luhn(number: str) -> bool:
    digits = [int(c) for c in number if c.isdigit()]
    total = 0
    for index, digit in enumerate(reversed(digits)):
        if index % 2 == 1:
            digit *= 2
            if digit > 9:
                digit -= 9
        total += digit
    return len(digits) >= 13 and total % 10 == 0


def validate_secret(label: str, match: re.Match, line: str) -> bool:
    value = match.group(0)
    lowered = value.lower()
    if "example" in lowered or "placeholder" in lowered:
        return False
    if label == "AWS access key" and "EXAMPLE" in value:
        return False
    if label == "OpenAI key" and lowered.startswith("sk-ant-"):
        return False
    if label == "Credentials in URL":
        if any(word in lowered for word in ("user:pass", "user:password", "username:password")):
            return False
    if label == "Hardcoded password":
        value = match.group(1)
        if PLACEHOLDER.search(value) or entropy(value) < 3.0:
            return False
    if label == "Hardcoded secret assignment":
        keyword = match.group(1).lower()
        value = match.group(2)
        if PLACEHOLDER.search(value):
            return False
        if keyword in ("secret", "token"):
            # Bare "secret"/"token" is common in code, so demand more evidence.
            if len(value) < 24 or entropy(value) < 3.4:
                return False
        elif entropy(value) < 3.0:
            return False
    return True


def validate_pii(label: str, match: re.Match, line: str) -> bool:
    value = match.group(0)
    if label == "Email address":
        local, _, domain = value.partition("@")
        tld = domain.rsplit(".", 1)[-1].lower()
        if domain.lower() in SAFE_EMAIL_DOMAINS:
            return False
        if local.lower() in SAFE_EMAIL_LOCALS:
            return False
        if tld in EXAMPLE_EMBEDDED_EXTS:
            return False
        if domain[:1].isdigit():
            return False
        return True
    if label == "Home directory path":
        return match.group(1) not in SAFE_USER_DIRS
    if label == "US phone number":
        digits = re.sub(r"\D", "", value)
        if len(digits) < 10:
            return False
        if re.search(r"555-01\d\d", value):
            return False
        if len(set(digits)) == 1:
            return False
        return True
    if label == "SSN":
        if value in ("123-45-6789",) or value.startswith("000-"):
            return False
        parts = value.split("-")
        if parts[1] == "00" or parts[2] == "0000":
            return False
        return True
    if label == "Payment card number":
        digits = re.sub(r"\D", "", value)
        return len(digits) >= 13 and len(set(digits)) > 1 and luhn(digits)
    if label == "MAC address":
        return value.lower() not in SAFE_MACS
    return True


# ---------------------------------------------------------------------------
# Git helpers
# ---------------------------------------------------------------------------


def run_git(args: list[str], binary: bool = False):
    return subprocess.run(["git", *args], capture_output=True, text=not binary)


def staged_paths() -> list[str]:
    result = run_git(["diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR"], binary=True)
    if result.returncode != 0:
        return []
    return [p.decode("utf-8", "replace") for p in result.stdout.split(b"\0") if p]


def blob_size(path: str) -> int | None:
    result = run_git(["cat-file", "-s", f":{path}"])
    if result.returncode != 0:
        return None
    try:
        return int(result.stdout.strip())
    except ValueError:
        return None


def blob_bytes(path: str) -> bytes | None:
    result = run_git(["cat-file", "blob", f":{path}"], binary=True)
    if result.returncode != 0:
        return None
    return result.stdout


def path_problem(path: str) -> str | None:
    base = path.rsplit("/", 1)[-1]
    for pattern, label in PATH_RULES:
        if base in ENV_TEMPLATES and label == "environment file":
            continue
        if pattern.search(path):
            return label
    return None


def scan_text(text: str, path: str):
    findings = []
    warnings = []
    for lineno, line in enumerate(text.splitlines(), 1):
        if any(marker in line for marker in ALLOW_MARKERS):
            continue
        line = line[:MAX_LINE_CHARS]
        for label, pattern in SECRET_RULES:
            for match in pattern.finditer(line):
                if validate_secret(label, match, line):
                    findings.append(("secret", path, lineno, label, match.group(0)))
        for label, pattern in PII_RULES:
            for match in pattern.finditer(line):
                if validate_pii(label, match, line):
                    findings.append(("personal", path, lineno, label, match.group(0)))
        for label, pattern in WARN_RULES:
            for match in pattern.finditer(line):
                warnings.append((path, lineno, label, match.group(0)))
    return findings, warnings


# ---------------------------------------------------------------------------
# Optional gitleaks pass
# ---------------------------------------------------------------------------


def staged_lines(path: str, cache: dict[str, list[str]]) -> list[str]:
    if path not in cache:
        data = blob_bytes(path)
        text = data.decode("utf-8", "replace") if data is not None else ""
        cache[path] = text.splitlines()
    return cache[path]


def gitleaks_findings() -> list[tuple[str, str, int, str, str]]:
    binary = shutil.which("gitleaks")
    if not binary:
        return []
    handle, report = tempfile.mkstemp(prefix="finder7-gitleaks-", suffix=".json")
    os.close(handle)
    try:
        subprocess.run(
            [
                binary, "git", "--staged", "--no-banner", "--no-color",
                "--redact", "-f", "json", "-r", report, "--exit-code", "1",
            ],
            capture_output=True,
        )
        with open(report, encoding="utf-8") as stream:
            data = json.load(stream)
        findings = []
        cache: dict[str, list[str]] = {}
        for item in data:
            path = item.get("File", "?")
            start = int(item.get("StartLine") or 0)
            end = int(item.get("EndLine") or start)
            lines = staged_lines(path, cache)
            # Honour this hook's allow marker for gitleaks findings too.
            if any(
                marker in line
                for line in lines[max(0, start - 1):max(1, end)]
                for marker in ALLOW_MARKERS
            ):
                continue
            findings.append(
                ("secret", path, start, f"gitleaks: {item.get('RuleID', 'rule')}",
                 item.get("Secret", ""))
            )
        return findings
    except (OSError, ValueError):
        return []
    finally:
        try:
            os.unlink(report)
        except OSError:
            pass


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def redact(value: str) -> str:
    value = value.strip()
    if len(value) <= 10:
        return value
    return f"{value[:6]}…{value[-4:]}"


def main() -> int:
    paths = staged_paths()
    if not paths:
        return 0

    findings: list[tuple[str, str, int, str, str]] = []
    warnings: list[tuple[str, int, str, str]] = []
    scanned = skipped_binary = skipped_large = 0

    for path in paths:
        problem = path_problem(path)
        if problem:
            findings.append(("secret", path, 0, problem, path))
            continue
        size = blob_size(path)
        if size is None:
            continue
        if size > MAX_SCAN_BYTES:
            skipped_large += 1
            continue
        data = blob_bytes(path)
        if data is None:
            continue
        if b"\0" in data[:8192]:
            skipped_binary += 1
            continue
        scanned += 1
        found, warned = scan_text(data.decode("utf-8", "replace"), path)
        findings.extend(found)
        warnings.extend(warned)

    if not findings:
        findings.extend(gitleaks_findings())

    if VERBOSE:
        print(
            f"secret-scan: {scanned} text file(s) scanned, "
            f"{skipped_binary} binary and {skipped_large} large file(s) skipped"
        )

    if findings:
        print("\npre-commit: commit blocked — staged changes contain secrets or personal data\n")
        for severity, path, lineno, label, value in findings[:20]:
            location = f"{path}:{lineno}" if lineno else path
            tag = "secret" if severity == "secret" else "personal data"
            print(f"  [{tag}] {location}  {label}")
            if value and value != path:
                print(f"           {redact(value)}")
        if len(findings) > 20:
            print(f"  … and {len(findings) - 20} more")
        print(
            "\nRemove the data from the staged file (git restore --staged <file>),"
            "\nor move it to an environment variable, Keychain, or an ignored file."
        )
        print("If this is a verified false positive, exempt the line with"
              " 'secret-scan:allow' or use: git commit --no-verify\n")
        return 1

    for path, lineno, label, value in warnings[:10]:
        print(f"pre-commit warning: {path}:{lineno} {label} ({redact(value)}) — not blocking")
    return 0


if __name__ == "__main__":
    sys.exit(main())
