#!/usr/bin/env python3
"""Finder7 pre-commit guard.

Scans the *staged* content (never the working tree) and aborts the commit when
it finds credentials, secrets or personal data.

  * credential files by path: .env, *.pem, *.p12, *.key, id_rsa, .netrc, ...
  * provider tokens: AWS, GitHub, GitLab, Slack, Stripe, Google, OpenAI,
    Anthropic, Hugging Face, npm, PyPI, SendGrid, DigitalOcean, Telegram,
    Discord, Azure, Vault
  * private key blocks, JWTs, bearer tokens, credentials inside URLs
  * hardcoded key/token/password assignments
  * personal data: home-directory paths, personal email addresses, phone
    numbers, SSNs, payment card numbers, MAC addresses
  * private-network IPv4 addresses (warning only)

If gitleaks (https://github.com/gitleaks/gitleaks) is on PATH it is also run
over the staged diff as an independent second opinion.

Annotations
-----------
Add ``secret-scan:allow`` (or ``gitleaks:allow``) to a line to exempt it.
Bypass the whole hook for one commit with ``git commit --no-verify`` — only do
that when you are certain the finding is a false positive.

Installation
------------
    git config core.hooksPath .githooks     # or ./Scripts/install-hooks.sh

Set SECRET_SCAN_VERBOSE=1 to print scan statistics.
"""

from __future__ import annotations

import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile

MAX_SCAN_BYTES = 2_000_000
MAX_LINE_CHARS = 8_000
ALLOW_MARKERS = ("secret-scan:allow", "gitleaks:allow")
VERBOSE = os.environ.get("SECRET_SCAN_VERBOSE") == "1"

# ---------------------------------------------------------------------------
# Path rules
# ---------------------------------------------------------------------------

ENV_TEMPLATES = {".env.example", ".env.sample", ".env.template", ".env.dist"}

PATH_RULES = [
    (re.compile(r"(^|/)\.env$"), "environment file"),
    (re.compile(r"(^|/)\.env\.[^/]+$"), "environment file"),
    (re.compile(r"(^|/)[^/]+\.env$"), "environment file"),
    (re.compile(r"(^|/)\.envrc$"), "direnv environment file"),
    (re.compile(r"(^|/)\.direnv(/|$)"), "direnv environment file"),
    (re.compile(r"(^|/)(id_rsa|id_dsa|id_ecdsa|id_ed25519)(\.[^/]*)?$"), "SSH private key"),
    (re.compile(r"(^|/)\.netrc$"), "netrc credentials"),
    (re.compile(r"(^|/)\.git-credentials$"), "git credentials"),
    (re.compile(r"(^|/)\.npmrc$"), "npm credentials"),
    (re.compile(r"(^|/)\.pypirc$"), "PyPI credentials"),
    (re.compile(r"(^|/)\.htpasswd$"), "htpasswd credentials"),
    (re.compile(r"(^|/)\.ssh(/|$)"), "SSH material"),
    (re.compile(r"(^|/)\.aws(/|$)"), "cloud credentials"),
    (re.compile(r"(^|/)\.terraform(/|$)"), "Terraform state"),
    (re.compile(r"(^|/)\.kube(/|$)"), "Kubernetes credentials"),
    (re.compile(r"(^|/)\.docker/config\.json$"), "Docker credentials"),
    (
        re.compile(r"(^|/)(secrets?|credentials)\.(json|ya?ml|toml|txt)$"),
        "secrets file",
    ),
    (re.compile(r"(^|/)service[-_]?account[^/]*\.json$"), "service account key"),
    (
        re.compile(
            r"\.(pem|p12|pfx|key|p8|jks|keystore|mobileprovision|provisionprofile|"
            r"ovpn|kdbx|tfvars|tfstate|netrc|sqlite|sqlite3)$"
        ),
        "credential file",
    ),
    (re.compile(r"(^|/)Vendor/7zz$"), "vendored engine binary"),
    (re.compile(r"(^|/)(\.build|\.swiftpm|dist|archive)(/|$)"), "ignored build/archive output"),
    (re.compile(r"(^|/)\.DS_Store$"), "macOS metadata"),
